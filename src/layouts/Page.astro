---
interface Props {
  frontmatter: {
    title: string;
    noIndex?: boolean;
  };
}

const { title, noIndex = false } = Astro.props.frontmatter;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#121212" />
    {noIndex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html {
    color-scheme: dark;
    background: #121212;
    color: #e6e6e6;
  }

  body {
    margin: 2rem;
    font-family: "Times New Roman", Times, serif;
    line-height: 1.6;
  }

  a {
    color: #9fc5ff;
  }

  a:visited {
    color: #c4b5fd;
  }
</style>
